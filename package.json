{
    "name": "structural-codes",
    "version": "0.1.0-alpha.1",
    "description": "Corpus strutturato, versionato e verificabile delle NTC 2018 e della Circolare 7/2019, predisposto per l'uso da applicazioni downstream.",
    "license": "LGPL-2.1-or-later",
    "homepage": "https://github.com/claudiopagani/structural-codes#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/claudiopagani/structural-codes.git"
    },
    "bugs": {
        "url": "https://github.com/claudiopagani/structural-codes/issues"
    },
    "keywords": [
        "structural-engineering",
        "civil-engineering",
        "building-codes",
        "ntc2018",
        "italian-regulations",
        "machine-readable-law"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./corpus": {
            "types": "./dist/corpus/index.d.ts",
            "import": "./dist/corpus/index.js",
            "default": "./dist/corpus/index.js"
        },
        "./schema": {
            "types": "./dist/schema/index.d.ts",
            "import": "./dist/schema/index.js",
            "default": "./dist/schema/index.js"
        },
        "./lib": {
            "types": "./dist/lib/index.d.ts",
            "import": "./dist/lib/index.js",
            "default": "./dist/lib/index.js"
        },
        "./corpus/manifest.json": "./corpus/manifest.json",
        "./corpus/units/*": "./corpus/units/*",
        "./corpus/assets/*": "./corpus/assets/*",
        "./schemas/*": "./schemas/*",
        "./sources/registry": "./sources/registry/sources.v2.json",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "schemas",
        "corpus",
        "sources/registry",
        "README.md",
        "LICENSE",
        "NOTICE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": "^22.13.0 || >=24.0.0"
    },
    "scripts": {
        "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint src scripts tests --max-warnings 0",
        "validate:sources": "node --experimental-strip-types scripts/verify-source-registry-v2.ts",
        "validate:sources:registry": "node --experimental-strip-types scripts/verify-source-registry-v2.ts --registry-only",
        "validate:corpus": "node --experimental-strip-types scripts/validate-corpus-v2.ts",
        "verify:sources:online": "node --experimental-strip-types scripts/verify-source-registry-v2.ts --online",
        "validate": "npm run validate:sources && npm run validate:corpus",
        "validate:ci": "npm run validate:sources:registry && npm run validate:corpus",
        "acquire:source": "node --experimental-strip-types scripts/acquire-source-v2.ts",
        "extract:evidence": "node --experimental-strip-types scripts/extract-evidence.ts",
        "render:evidence": "node --experimental-strip-types scripts/render-evidence.ts",
        "verify:evidence": "node --experimental-strip-types scripts/verify-evidence.ts",
        "verify:evidence:release": "node --experimental-strip-types scripts/verify-evidence.ts --require-local --require-samples",
        "normalize:text": "node --experimental-strip-types scripts/normalize-text.ts",
        "review:diff": "node --experimental-strip-types scripts/generate-review-diff.ts",
        "corpus:circ12:figures": "python scripts/extract-circ12-figures.py",
        "corpus:circ3:step1:figures": "python scripts/extract-circ3-step1-figures.py",
    "corpus:circ3:step2:figures": "python scripts/extract-circ3-step2-figures.py",
    "corpus:circ3:figure-label-crops": "node --experimental-strip-types scripts/fix-circ3-figure-label-crops.ts",
    "corpus:circ3:evidence-fix": "node --experimental-strip-types scripts/fix-circ3-evidence-spans.ts",
        "corpus:inline-fraction-layout": "node --experimental-strip-types scripts/fix-inline-fraction-layout.ts",
        "corpus:continuous-notes": "node --experimental-strip-types scripts/fix-continuous-note-flow.ts",
        "corpus:circ3:step3:figures": "python scripts/extract-circ3-step3-figures.py",
        "corpus:circ41:figures": "python scripts/extract-circ41-figures.py",
    "corpus:ntc74:step1:figures": "python scripts/extract-ntc74-step1-figures.py",
    "corpus:ntc74:step2:figures": "python scripts/extract-ntc74-step2-figures.py",
    "corpus:ntc11:table-editorial": "node --experimental-strip-types scripts/fix-ntc11-table-editorial.ts",
    "corpus:ntc11:3-table-editorial": "node --experimental-strip-types scripts/fix-ntc11-3-table-editorial.ts",
    "corpus:ntc11:followup-editorial": "node --experimental-strip-types scripts/fix-ntc11-followup-editorial.ts",
    "corpus:ntc11:9-10-editorial": "node --experimental-strip-types scripts/fix-ntc11-9-10-editorial.ts",
    "corpus:circ11:editorial": "node --experimental-strip-types scripts/fix-circ11-editorial.ts",
    "corpus:circ11:followup-editorial": "node --experimental-strip-types scripts/fix-circ11-followup-editorial.ts",
    "corpus:ntc5:step1:figures": "python scripts/extract-ntc5-figures.py",
    "corpus:ntc5:step2:figures": "python scripts/extract-ntc5-step2-figures.py",
    "corpus:ntc5:table-images": "python scripts/extract-ntc5-table-images.py",
    "corpus:ntc5:editorial-fixes": "node --experimental-strip-types scripts/fix-ntc5-editorial.ts",
    "corpus:ntc4:title-spacing": "node --experimental-strip-types scripts/fix-ntc4-title-spacing.ts",
    "corpus:ntc43:step1:figures": "python scripts/extract-ntc43-step1-figures.py",
    "corpus:ntc43:step2:figures": "python scripts/extract-ntc43-step2-figures.py",
    "corpus:ntc43:step3:figures": "python scripts/extract-ntc43-step3-figures.py",
    "corpus:ntc43:table3:figures": "python scripts/extract-ntc43-table-iii-figures.py",
    "corpus:ntc43:step4:figures": "python scripts/extract-ntc43-step4-figures.py",
    "corpus:ntc42:step4c:figures": "python scripts/extract-ntc42-step4c-table-x-figures.py",
    "corpus:ntc42:step6:figures": "python scripts/extract-ntc42-step6-figures.py",
    "corpus:circ74:figures": "python scripts/extract-circ74-figures.py",
    "corpus:circ75:step1:figures": "python scripts/extract-circ75-step1-figures.py",
    "corpus:circ76:step1:figures": "python scripts/extract-circ76-step1-figures.py",
    "corpus:circ78-79:step1:figures": "python scripts/extract-circ78-79-step1-figures.py",
    "corpus:circ710:step1:figures": "python scripts/extract-circ710-step1-figures.py",
    "corpus:circ7:figures": "python scripts/extract-circ7-figures.py",
    "corpus:ntc3:figures": "python scripts/extract-ntc3-figures.py",
    "corpus:ntc3236:inline": "node --experimental-strip-types scripts/fix-ntc3236-inline-math.ts",
    "corpus:ntc314:flow": "node --experimental-strip-types scripts/clean-ntc314-table-flow.ts",
        "corpus:circ43:figures": "python scripts/extract-circ43-figures.py",
        "corpus:circ43:table1:figure": "python scripts/extract-circ43-table-i-figure.py",
        "corpus:figures:center": "node --experimental-strip-types scripts/crop-figure-horizontal-margins.ts",
        "build": "npm run build:package",
        "build:package": "node scripts/build-package.mjs",
        "viewer:install": "node scripts/install-viewer-dependencies.mjs",
        "dev": "npm --prefix viewer run dev:chatntc",
        "viewer:dev": "npm --prefix viewer run dev",
        "viewer:build": "npm --prefix viewer run build",
        "viewer:start": "npm --prefix viewer run start",
        "viewer:check": "npm --prefix viewer run check",
        "viewer:test": "npm --prefix viewer test",
        "audit:production": "npm audit --omit=dev",
        "viewer:audit:production": "npm --prefix viewer audit --omit=dev",
        "check": "npm run validate && npm run verify:evidence && npm run typecheck && npm run lint && npm test",
        "check:ci": "npm run validate:ci && npm run verify:evidence && npm run typecheck && npm run lint && npm test",
        "release:verify:package": "npm run build:package && node scripts/verify-release.mjs",
        "release:verify": "npm run check && npm run verify:evidence:release && npm run audit:production && npm run viewer:check && npm run viewer:audit:production && npm run release:verify:package",
        "prepack": "npm run build:package"
    },
    "dependencies": {
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@napi-rs/canvas": "^1.0.2",
        "@types/node": "^22.10.0",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "canonicalize": "^3.0.0",
        "diff": "^8.0.4",
        "eslint": "^10.8.0",
        "globals": "^17.7.0",
        "pdfjs-dist": "^4.10.38",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.65.0"
    }
}
