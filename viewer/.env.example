# Copy to viewer/.env.local (ignored by Git). No NEXT_PUBLIC_ or VITE_ secrets.
CHATNTC_ENABLED=false
CHATNTC_PROVIDER=deepseek
CHATNTC_DEEPSEEK_API_KEY=
CHATNTC_DEEPSEEK_MODEL=deepseek-flash
CHATNTC_DEEPSEEK_TIMEOUT_MS=60000
# Alternatively enter a key in local AI settings (memory only). No key is required in this file.
CHATNTC_OPENAI_API_KEY=
CHATNTC_OPENAI_MODEL=gpt-5.6-luna
CHATNTC_ANTHROPIC_API_KEY=
CHATNTC_ANTHROPIC_MODEL=claude-sonnet-5
CHATNTC_GEMINI_API_KEY=
CHATNTC_GEMINI_MODEL=gemini-3.8-flash
# Fifth provider: OpenRouter accepts manual vendor/model IDs, not an allowlist.
# Copy the exact catalog ID, not its URL; underscores are not converted to hyphens.
# Suggestions do not guarantee availability or free access. openrouter/auto can charge.
# Uses prompt-json, shared validation and at most one bounded format retry.
# Only CHATNTC_OPENROUTER_API_KEY is used here; no cross-provider key fallback.
CHATNTC_OPENROUTER_API_KEY=
CHATNTC_OPENROUTER_MODEL=openrouter/auto
# Shared deadline, including the optional single format retry.
CHATNTC_TIMEOUT_MS=60000
# Explicit opt-in for local debugging of a production build; keep false on public deployments.
CHATNTC_DEBUG=false
