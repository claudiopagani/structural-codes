{
  "name": "structural-codes-viewer",
  "version": "0.1.0-alpha.1",
  "description": "Reference React UI and deterministic artifact client for the structural-codes corpus.",
  "license": "LGPL-2.1-or-later",
  "homepage": "https://github.com/claudiopagani/structural-codes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claudiopagani/structural-codes.git",
    "directory": "viewer"
  },
  "files": ["package-dist", "README.md", "LICENSE", "NOTICE"],
  "main": "./package-dist/NormativeViewer.js",
  "types": "./package-dist/NormativeViewer.d.ts",
  "bin": {
    "structural-codes-viewer": "./package-dist/generate-artifacts.mjs"
  },
  "exports": {
    ".": {
      "types": "./package-dist/NormativeViewer.d.ts",
      "import": "./package-dist/NormativeViewer.js",
      "default": "./package-dist/NormativeViewer.js"
    },
    "./styles.css": "./package-dist/styles.css",
    "./generate-artifacts": "./package-dist/generate-artifacts.mjs",
    "./corpus-data": {
      "types": "./package-dist/corpusData.d.ts",
      "import": "./package-dist/corpusData.js",
      "default": "./package-dist/corpusData.js"
    },
    "./chatntc": {
      "types": "./package-dist/chatntc/index.d.ts",
      "import": "./package-dist/chatntc/index.js",
      "default": "./package-dist/chatntc/index.js"
    },
    "./chatntc/viewer-artifacts": {
      "types": "./package-dist/chatntc/viewerArtifacts.d.ts",
      "import": "./package-dist/chatntc/viewerArtifacts.js",
      "default": "./package-dist/chatntc/viewerArtifacts.js"
    },
    "./package.json": "./package.json",
    "./chatntc-ui": {
      "types": "./package-dist/chatntc-ui/index.d.ts",
      "import": "./package-dist/chatntc-ui/index.js",
      "default": "./package-dist/chatntc-ui/index.js"
    },
    "./chatntc-history": {
      "types": "./package-dist/chatntc-history/index.d.ts",
      "import": "./package-dist/chatntc-history/index.js",
      "default": "./package-dist/chatntc-history/index.js"
    }
  },
  "publishConfig": {"access": "public"},
  "allowScripts": {
    "unrs-resolver@1.11.1": true
  },
  "scripts": {
    "sync:corpus": "node scripts/sync-corpus.mjs",
    "build:library": "node scripts/build-library.mjs",
    "pack:verify": "npm run build:library && npm pack --dry-run",
    "test:consumer": "node scripts/test-consumer.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "npm run sync:corpus && vinext dev",
    "dev:chatntc": "npm run sync:corpus && node scripts/dev-chatntc.mjs",
    "build": "npm run sync:corpus && vinext build",
    "start": "vinext start",
    "performance:baseline": "npm run build && node scripts/performance-baseline.mjs",
    "performance:search": "npm run sync:corpus && node scripts/search-performance.mjs",
    "test:chatntc": "npm run build:library && npm run sync:corpus && node --test tests/chatntc-core.test.mjs tests/chatntc-artifacts.test.mjs",
    "build:chatntc-test": "tsc -p tsconfig.chatntc-test.json",
    "test:chatntc-server": "npm run sync:corpus && npm run build:chatntc-test && node --conditions=react-server --test tests/chatntc-server.test.mjs tests/chatntc-semantic-retrieval.test.mjs",
    "build:chatntc-semantic-tool": "tsc -p tsconfig.semantic-tool.json",
    "chatntc:semantic:index": "npm run sync:corpus && npm run build:chatntc-semantic-tool && node .local/chatntc-semantic-tool/scripts/generate-chatntc-semantic-index.js",
    "chatntc:semantic:validate": "npm run sync:corpus && npm run build:chatntc-semantic-tool && node .local/chatntc-semantic-tool/scripts/generate-chatntc-semantic-index.js --validate-only",
    "test:chatntc-semantic": "npm run build:chatntc-semantic-tool && node --test tests/chatntc-semantic.test.mjs",
    "test": "npm run build:library && npm run build && node --test tests/rendered-html.test.mjs tests/comparison-viewer.test.mjs tests/performance-phase-one.test.mjs tests/search-phase-two.test.mjs tests/cross-reference-phase-three.test.mjs tests/lazy-navigation-consolidation.test.mjs tests/package-boundary.test.mjs tests/ntc-latex-corpus.test.mjs tests/chatntc-core.test.mjs tests/chatntc-artifacts.test.mjs tests/chatntc-route.test.mjs tests/chatntc-history.test.mjs && npm run test:chatntc-semantic && npm run build:chatntc-test && node --conditions=react-server --test tests/chatntc-server.test.mjs tests/chatntc-semantic-retrieval.test.mjs && npm run test:chatntc-ui",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern package-dist --ignore-pattern .next --max-warnings 0",
    "check": "npm run lint && npm test",
    "test:chatntc-ui": "npm run sync:corpus && node scripts/build-chatntc-ui-test.mjs && node --test tests/chatntc-ui.test.mjs",
    "test:chatntc-history": "npm run build:library && node --test tests/chatntc-history.test.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource/tinos": "^5.3.0",
    "katex": "^0.16.22",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "structural-codes": "file:..",
    "next": "16.3.2",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "26.1.0",
    "react-server-dom-webpack": "19.2.8",
    "server-only": "0.0.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.1.5"
  },
  "type": "module"
}
