            "value": "−5°",
            "latex": "-5^\\circ"
          },
          {
            "kind": "text",
            "value": " e "
          },
          {
            "kind": "math",
            "value": "+5°",
            "latex": "+5^\\circ"
          },
          {
            "kind": "text",
            "value": ". L’altezza di riferimento "
