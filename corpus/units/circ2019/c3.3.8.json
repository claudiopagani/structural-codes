    {
      "blockId": "urn:structural-codes:it:unit:circ2019:c3.3.8#block-editorial-003",
      "kind": "list-item",
      "origin": "official",
      "text": {
        "raw": "distinte serie di coefficienti di pressione esterna:- coefficienti globali c pe, che possono essere utilizzati in tutti i casi in cui la rappresentazione delle azioni aerodinamiche del",
        "normalized": "coefficienti globali cpe, che possono essere utilizzati in tutti i casi in cui la rappresentazione delle azioni aerodinamiche del vento possa essere effettuata in maniera semplificata, rivolta alla valutazione delle azioni globali su porzioni estese di costruzioni o delle risultanti delle azioni indotte dal vento sugli elementi principali della struttura;",
        "normalizationVersion": "core-editorial-profile-0.1.0",
        "inline": [
          {
            "kind": "text",
            "value": "coefficienti globali "
          },
          {
            "kind": "math",
            "value": "cpe",
            "latex": "c_{pe}"
          },
          {
            "kind": "text",
            "value": ", che possono essere utilizzati in tutti i casi in cui la rappresentazione delle azioni aerodinamiche del vento possa essere effettuata in maniera semplificata, rivolta alla valutazione delle azioni globali su porzioni estese di costruzioni o delle risultanti delle azioni indotte dal vento sugli elementi principali della struttura;"
          }
        ]
