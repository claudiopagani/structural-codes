    {
      "blockId": "urn:structural-codes:it:unit:ntc2018:3.6.3.4#block-editorial-001",
      "kind": "paragraph",
      "origin": "official",
      "text": {
        "raw": "Al verificarsi di un deragliamento può esservi il rischio di collisione fra i veicoli deragliati e le strutture adiacenti la ferrovia.",
        "normalized": "Al verificarsi di un deragliamento può esservi il rischio di collisione fra i veicoli deragliati e le strutture adiacenti la ferrovia.",
        "normalizationVersion": "core-editorial-profile-0.1.0"
      },
      "evidence": {
        "sourceId": "gu-so8-2018-ntc",
        "pdfPage": 71,
        "printedPage": "67",
        "region": {
          "coordinateSystem": "pdf-points-top-left",
          "x": 72.25,
          "y": 215.214,
          "width": 450.043,
          "height": 177.046
        },
        "extraction": {
          "method": "pdf-text",
          "tool": "pdfjs-dist",
          "toolVersion": "4.10.38"
        },
        "transformations": [],
        "rawSha256": "8fd4b92e699549a6f4b4b57036a0b00824f4e07cda832494b5f8ba5c55897f6b",
        "normalizedSha256": "8fd4b92e699549a6f4b4b57036a0b00824f4e07cda832494b5f8ba5c55897f6b"
      }
    },
    {
      "blockId": "urn:structural-codes:it:unit:ntc2018:3.6.3.4#block-editorial-002",
      "kind": "paragraph",
      "origin": "official",
      "text": {
        "raw": "Queste ultime dovranno essere progettate in modo da resistere alle azioni conseguenti ad una tale evenienza.",
        "normalized": "Queste ultime dovranno essere progettate in modo da resistere alle azioni conseguenti ad una tale evenienza.",
        "normalizationVersion": "core-editorial-profile-0.1.0"
      },
      "evidence": {
        "sourceId": "gu-so8-2018-ntc",
        "pdfPage": 71,
        "printedPage": "67",
        "region": {
          "coordinateSystem": "pdf-points-top-left",
          "x": 72.25,
          "y": 215.214,
          "width": 450.043,
          "height": 177.046
        },
        "extraction": {
          "method": "pdf-text",
          "tool": "pdfjs-dist",
          "toolVersion": "4.10.38"
        },
        "transformations": [],
        "rawSha256": "1bebf0a63ff806c1c8adaedb82659dfae228743ae4c27028a77dc13324a88bab",
