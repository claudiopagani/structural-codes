        "normalizationVersion": "core-editorial-profile-0.1.0",
        "inline": [
          {
            "kind": "text",
            "value": "La vita nominale di progetto "
          },
          {
            "kind": "math",
            "value": "VN",
            "latex": "V_N"
          },
          {
            "kind": "text",
            "value": " di un’opera è convenzionalmente definita come il numero di anni nel quale è previsto che l’opera, purché soggetta alla necessaria manutenzione, mantenga specifici livelli prestazionali."
