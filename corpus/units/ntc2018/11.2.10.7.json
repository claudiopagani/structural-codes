          },
          {
            "kind": "text",
            "value": " di messa in carico, non è superiore a "
          },
          {
            "kind": "math",
            "value": "0,45 fckj",
            "latex": "0{,}45f_{ckj}"
          },
          {
            "kind": "text",
            "value": ", il coefficiente di viscosità "
