        "normalizationVersion": "ntc6-editorial-profile-0.1.0",
        "inline": [
          {
            "kind": "text",
            "value": "I coefficienti parziali "
          },
          {
            "kind": "math",
            "value": "γF",
            "latex": "\\gamma_F"
          },
          {
            "kind": "text",
            "value": " relativi alle azioni sono indicati nella Tab. 6.2.I. Ad essi deve essere fatto riferimento con le precisazioni riportate nel § 2.6.1. Si deve comunque intendere che il terreno e l’acqua costituiscono carichi permanenti (strutturali) quando, nella modellazione utilizzata, contribuiscono al comportamento dell’opera con le loro caratteristiche di peso, resistenza e rigidezza."
          }
        ]
