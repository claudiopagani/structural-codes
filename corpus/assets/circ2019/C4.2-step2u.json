      "officialNumber": "C4.2.104",
      "pdfPage": 136,
      "latex": "g_r=r_m\\left[\\tan\\left(\\frac{\\Phi}{2}\\right)-\\sin\\left(\\frac{\\Phi}{2}\\right)\\right]"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.105",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.12.1.4",
      "officialNumber": "C4.2.105",
      "pdfPage": 138,
      "latex": "\\sigma_{cr,s}=2\\cdot\\frac{\\sqrt{k\\cdot E\\cdot I_s}}{A_s}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.106",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.12.1.4",
      "officialNumber": "C4.2.106",
      "pdfPage": 138,
      "latex": "\\lambda_d=\\sqrt{\\frac{f_{yk}}{\\sigma_{cr,s}}}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.107",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.12.1.4",
      "officialNumber": "C4.2.107",
      "pdfPage": 138,
      "latex": "\\sigma_{d,Rd}=\\chi_d(\\lambda_d)\\,f_{yk}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.108",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.12.1.4",
      "officialNumber": "C4.2.108",
      "pdfPage": 138,
      "latex": "\\begin{aligned}\\chi_d&=1&&\\text{per }\\lambda_d<0{,}65\\\\\\chi_d&=1{,}47-0{,}723\\cdot\\lambda_d&&\\text{per }0{,}65\\le\\lambda_d\\le1{,}38\\\\\\chi_d&=\\frac{0{,}66}{\\lambda_d}&&\\text{per }\\lambda_d>1{,}38\\end{aligned}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.109",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.12.1.4",
      "officialNumber": "C4.2.109",
      "pdfPage": 138,
      "latex": "\\sigma_{com,Ed,i}=\\chi_d\\cdot\\frac{f_{yk}}{\\gamma_{M0}}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.110",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.12.1.4",
      "officialNumber": "C4.2.110",
      "pdfPage": 138,
      "latex": "\\sigma_{d,Rd}=\\chi_d(\\lambda'_d)\\,f_{yk}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.111",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.12.1.4",
      "officialNumber": "C4.2.111",
      "pdfPage": 138,
      "latex": "A_{s,rid}=\\frac{\\chi_d\\cdot f_{yk}\\cdot A_s}{\\gamma_{M0}\\cdot\\sigma_{com,Ed}}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.112",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.12.1.4",
      "officialNumber": "C4.2.112",
      "pdfPage": 139,
      "latex": "t_{rid}=t\\cdot\\frac{A_{s,rid}}{A_s}"
    }
  ],
