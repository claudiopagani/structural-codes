  "formulas": [
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c7.2.1",
      "unitId": "urn:structural-codes:it:unit:circ2019:c7.2.3",
      "officialNumber": "C7.2.1",
      "pdfPage": 202,
      "latex": "S_{ij}=\\varphi_{ij}\\Gamma_i S_i(T_i)"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c7.2.2",
      "unitId": "urn:structural-codes:it:unit:circ2019:c7.2.3",
      "officialNumber": "C7.2.2",
      "pdfPage": 202,
      "latex": "\\Gamma_i=\\frac{\\boldsymbol{\\varphi}_i^{T}\\mathbf{M}\\boldsymbol{\\tau}}{\\boldsymbol{\\varphi}_i^{T}\\mathbf{M}\\boldsymbol{\\varphi}_i}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c7.2.3",
      "unitId": "urn:structural-codes:it:unit:circ2019:c7.2.3",
      "officialNumber": "C7.2.3",
      "pdfPage": 203,
      "latex": "S_{a,ij}=S_{ij}R\\left(\\frac{T_a}{T_i};\\xi_a\\right)"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c7.2.4",
      "unitId": "urn:structural-codes:it:unit:circ2019:c7.2.3",
      "officialNumber": "C7.2.4",
      "pdfPage": 203,
      "latex": "R=\\left[\\left(2\\xi_a\\frac{T_a}{T_i}\\right)^2+\\left(1-\\left(\\frac{T_a}{T_i}\\right)^2\\right)^2\\right]^{-\\beta}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c7.2.5",
      "unitId": "urn:structural-codes:it:unit:circ2019:c7.2.3",
      "officialNumber": "C7.2.5",
      "pdfPage": 203,
      "latex": "S_{eZ}(T,\\xi,z)=\\sqrt{\\sum_k\\left(S_{eZ,k}(T,\\xi,z)\\right)^2}\\;\\left(\\ge S_e(T,\\xi)\\text{ per }T>T_1\\right)"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c7.2.6",
      "unitId": "urn:structural-codes:it:unit:circ2019:c7.2.3",
      "officialNumber": "C7.2.6",
      "pdfPage": 204,
      "latex": "S_{eZ,k}(T,\\xi,z)=\\begin{cases}\\dfrac{1.1\\xi_k^{-0.5}\\eta(\\xi)a_{Z,k}(z)}{1+\\left[1.1\\xi_k^{-0.5}\\eta(\\xi)-1\\right]\\left(1-\\dfrac{T}{aT_k}\\right)^{1.6}}&\\text{per }T<aT_k\\\\1.1\\xi_k^{-0.5}\\eta(\\xi)a_{Z,k}(z)&\\text{per }aT_k\\le T<bT_k\\\\\\dfrac{1.1\\xi_k^{-0.5}\\eta(\\xi)a_{Z,k}(z)}{1+\\left[1.1\\xi_k^{-0.5}\\eta(\\xi)-1\\right]\\left(\\dfrac{T}{bT_k}-1\\right)^{1.2}}&\\text{per }T\\ge bT_k\\end{cases}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c7.2.7",
      "unitId": "urn:structural-codes:it:unit:circ2019:c7.2.3",
      "officialNumber": "C7.2.7",
      "pdfPage": 204,
      "latex": "a_{Z,k}(z)=S_e(T_k,\\xi_k)|\\gamma_k\\psi_k(z)|\\sqrt{1+0.0004\\xi_k^2}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c7.2.8",
      "unitId": "urn:structural-codes:it:unit:circ2019:c7.2.3",
      "officialNumber": "C7.2.8",
      "pdfPage": 204,
      "latex": "a_Z(z)=\\sqrt{\\sum_k\\left(a_{Z,k}(z)\\right)^2}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c7.2.9",
      "unitId": "urn:structural-codes:it:unit:circ2019:c7.2.3",
      "officialNumber": "C7.2.9",
      "pdfPage": 204,
      "latex": "S_{eZ,k}(T_k,\\xi_k,z)=1.1\\xi_k^{-0.5}\\eta(\\xi)a_{Z,k}(z)"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c7.2.10",
      "unitId": "urn:structural-codes:it:unit:circ2019:c7.2.3",
      "officialNumber": "C7.2.10",
      "pdfPage": 204,
      "latex": "\\gamma_1=\\frac{3n}{2n+1}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c7.2.11",
      "unitId": "urn:structural-codes:it:unit:circ2019:c7.2.3",
      "officialNumber": "C7.2.11",
      "pdfPage": 205,
      "latex": "S_a(T_a)=\\begin{cases}\\alpha S\\left(1+\\dfrac{z}{H}\\right)\\left[\\dfrac{a_p}{1+(a_p-1)\\left(1-\\dfrac{T_a}{aT_1}\\right)^2}\\right]\\ge\\alpha S&\\text{per }T_a<aT_1\\\\\\alpha S\\left(1+\\dfrac{z}{H}\\right)a_p&\\text{per }aT_1\\le T_a<bT_1\\\\\\alpha S\\left(1+\\dfrac{z}{H}\\right)\\left[\\dfrac{a_p}{1+(a_p-1)\\left(1-\\dfrac{T_a}{bT_1}\\right)^2}\\right]\\ge\\alpha S&\\text{per }T_a\\ge bT_1\\end{cases}"
    }
  ],
