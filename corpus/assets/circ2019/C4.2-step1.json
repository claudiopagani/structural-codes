      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.9",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.5",
      "officialNumber": "C4.2.9",
      "pdfPage": 103,
      "latex": "H_{Ed}\\ge0{,}15\\cdot V_{Ed}"
