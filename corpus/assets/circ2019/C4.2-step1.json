      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.8",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.5",
      "officialNumber": "C4.2.8",
      "pdfPage": 102,
      "latex": "\\frac{2}{3}\\le\\alpha_h=\\frac{2}{\\sqrt{h}}\\le1{,}0\\quad\\text{e da}\\quad\\alpha_m=\\sqrt{\\frac{1}{2}\\left(1+\\frac{1}{m}\\right)}"
    },
