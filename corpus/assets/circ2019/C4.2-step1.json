      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.1",
      "officialNumber": "C4.2.1",
      "pdfPage": 101,
      "latex": "\\bar{k}=\\sqrt{\\frac{f_{yk}}{\\gamma_{M0}\\cdot\\sigma_{c,Ed}}}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.2",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.3",
      "officialNumber": "C4.2.2",
      "pdfPage": 101,
      "latex": "M_{pl,Rd}=\\frac{W_{pl}f_{yk}}{\\gamma_{M0}}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.3",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.3",
      "officialNumber": "C4.2.3",
      "pdfPage": 101,
      "latex": "a^*=\\max\\left(2d;L_{0{,}8M_p}\\right)"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.4",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.3",
      "officialNumber": "C4.2.4",
      "pdfPage": 101,
      "latex": "\\frac{A\\cdot f_{yk}}{\\gamma_{M0}}\\le\\frac{0{,}9\\cdot A_{net}\\cdot f_{tk}}{\\gamma_{M2}}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.5",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.4",
      "officialNumber": "C4.2.5",
      "pdfPage": 102,
      "latex": "\\alpha_{cr}=\\frac{h\\cdot H_{Ed}}{\\delta\\cdot V_{Ed}}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.6",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.4",
      "officialNumber": "C4.2.6",
      "pdfPage": 102,
      "latex": "\\bar{\\lambda}\\le0{,}3\\cdot\\sqrt{\\frac{A\\cdot f_{yk}}{N_{Ed}}}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.7",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.5",
      "officialNumber": "C4.2.7",
      "pdfPage": 102,
      "latex": "\\phi=\\alpha_h\\alpha_m\\phi_0"
