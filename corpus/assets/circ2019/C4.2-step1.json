    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.10",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.5",
      "officialNumber": "C4.2.10",
      "pdfPage": 103,
      "latex": "\\bar{\\lambda}\\ge0{,}5\\cdot\\sqrt{\\frac{A\\cdot f_y}{N_{Ed}}}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.11",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.5",
      "officialNumber": "C4.2.11",
      "pdfPage": 103,
      "latex": "F_h=\\phi\\cdot N_{Ed}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.12",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.5",
      "officialNumber": "C4.2.12",
      "pdfPage": 103,
      "latex": "q_h=\\frac{8\\cdot e_{0,d}\\cdot N_{Ed}}{L^2}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.13",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.5",
      "officialNumber": "C4.2.13",
      "pdfPage": 104,
      "latex": "e_0=\\alpha_m\\cdot\\frac{L}{500}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.14",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.5",
      "officialNumber": "C4.2.14",
      "pdfPage": 104,
      "latex": "\\alpha_m=\\sqrt{\\frac{1}{2}\\left(1+\\frac{1}{m}\\right)}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.15",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.5",
      "officialNumber": "C4.2.15",
      "pdfPage": 104,
      "latex": "q_d=\\frac{8\\left(e_0+\\delta_q\\right)N_{Ed}}{L^2}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.16",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.5",
      "officialNumber": "C4.2.16",
      "pdfPage": 104,
      "latex": "N_{Ed}=\\frac{M_{Ed}}{h}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.17",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.5",
      "officialNumber": "C4.2.17",
      "pdfPage": 104,
      "latex": "F_d=\\alpha_m\\cdot\\phi_0=\\frac{\\alpha_m\\cdot N_{Ed}}{100}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.18",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.6",
      "officialNumber": "C4.2.18",
      "pdfPage": 105,
      "latex": "\\beta=\\frac{\\alpha_{cr}}{\\alpha_{cr}-1}"
    },
    {
      "id": "urn:structural-codes:it:asset:formula:circ2019:c4.2.19",
      "unitId": "urn:structural-codes:it:unit:circ2019:c4.2.3.7",
      "officialNumber": "C4.2.19",
      "pdfPage": 105,
      "latex": "\\frac{h}{t_f}\\le40\\cdot\\varepsilon"
