      "rows": [
        [
          {
            "text": "Classe di servizio 1"
          },
          {
            "text": "È caratterizzata da un’umidità del materiale in equilibrio con l’ambiente a una temperatura di 20 °C e un’umidità relativa dell’aria circostante che non superi il 65%, se non per poche settimane all’anno."
          }
        ],
        [
          {
            "text": "Classe di servizio 2"
          },
          {
            "text": "É caratterizzata da un’umidità del materiale in equilibrio con l’ambiente a una temperatura di 20 °C e un’umidità relativa dell’aria circostante che superi l’85% solo per poche settimane all’anno."
          }
        ],
        [
          {
            "text": "Classe di servizio 3"
          },
          {
            "text": "È caratterizzata da umidità più elevata di quella della classe di servizio 2."
          }
        ]
      ],
