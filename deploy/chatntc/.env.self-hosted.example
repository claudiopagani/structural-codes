# Copiare in deploy/chatntc/.env.self-hosted. Il file reale resta fuori da Git.

# Percorso standard: retrieval lessicale e strutturale, senza indice o GPU.
CHATNTC_SEMANTIC_MODE=off

# Lo stack pubblica ChatNTC soltanto sul loopback dell'host.
CHATNTC_HOST_PORT=3000

# Nomi/tag modificabili per build locali o registry scelti dall'utente.
CHATNTC_IMAGE=structural-codes/chatntc:self-hosted
BGE_IMAGE=structural-codes/bge-m3-embedding:experimental

# Provider generativo. Non commettere credenziali reali.
CHATNTC_PROVIDER=deepseek
CHATNTC_DEEPSEEK_API_KEY=
CHATNTC_DEEPSEEK_MODEL=deepseek-flash
CHATNTC_TIMEOUT_MS=120000

# Semantic retrieval sperimentale (shadow/on), attivo solo con il profilo semantic.
CHATNTC_EMBEDDING_PROVIDER=flagembedding-http
CHATNTC_EMBEDDING_URL=http://bge-m3-embedding:8000
CHATNTC_SEMANTIC_INDEX_HOST_PATH=
CHATNTC_SEMANTIC_INDEX_PATH=/app/data/chatntc-semantic
CHATNTC_EMBEDDING_TIMEOUT_MS=120000
CHATNTC_EMBEDDING_BATCH_SIZE=32
BGE_MODEL_CACHE=
