# Copy to deploy/chatntc/.env.production and keep the real file outside Git.
# Use absolute host paths. These Linux examples are intentionally generic.
BGE_MODEL_CACHE=/srv/ocfem/models/huggingface
CHATNTC_SEMANTIC_INDEX_HOST_PATH=/srv/ocfem/chatntc-semantic

# ChatNTC is exposed on host loopback only in this production-like stack.
CHATNTC_HOST_PORT=3000

# Optional immutable image names/tags for a registry or local build.
CHATNTC_IMAGE=structural-codes/chatntc:step-b6
BGE_IMAGE=structural-codes/bge-m3-embedding:step-b1

# Generation provider configuration. Do not commit real credentials.
CHATNTC_PROVIDER=deepseek
CHATNTC_DEEPSEEK_API_KEY=
CHATNTC_DEEPSEEK_MODEL=deepseek-flash
CHATNTC_TIMEOUT_MS=120000
